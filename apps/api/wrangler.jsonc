{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "travel-journal-api",
    "main": "src/index.ts",
    "compatibility_date": "2026-08-21",
    "compatibility_flags": ["nodejs_als"],
    "workers_dev": false,
    "preview_urls": true,
    "observability": {
        "enabled": true,
    },
    "dev": {
        "host": "localhost:5173",
    },
    "routes": [
        {
            "pattern": "travel-journal.stevenbister.com/api/*",
            "zone_id": "f7a683ffc045f37255a10a77fb5465cb",
        },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "travel-journal",
            "database_id": "6578e729-b943-414d-a4b9-9c1b764d7744",
            "migrations_dir": "src/db/migrations",
        },
    ],
}
