{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "where-in-the-world-api",
    "main": "src/index.ts",
    "compatibility_date": "2026-08-21",
    "compatibility_flags": ["nodejs_als"],
    "workers_dev": false,
    "preview_urls": true,
    "observability": {
        "enabled": true,
    },
    "routes": [
        {
            "pattern": "where-in-the-world.stevenbister.com/api/*",
            "zone_id": "f7a683ffc045f37255a10a77fb5465cb",
        },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "where-in-the-world",
            "database_id": "7fc19fec-d6e9-4ec2-a87b-d5c69d39e13c",
            "migrations_dir": "src/db/migrations",
        },
    ],
    "vars": {
        "BETTER_AUTH_ALLOWED_HOSTS": [
            "where-in-the-world.stevenbister.com",
            "*-where-in-the-world-api.stevebister.workers.dev",
        ],
    },
}
